{
  "name": "scoped-event-bus",
  "version": "0.4.0",
  "description": "A Typescript event bus with scoped events",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": "./dist/types.d.ts",
    "./dist/types": "./dist/types.d.ts"
  },
  "files": [
    "dist/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public && git push --follow-tags",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-19/scoped-event-bus.git"
  },
  "keywords": [
    "typescript",
    "events"
  ],
  "author": "Sampsa Lohi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sam-19/scoped-event-bus/issues"
  },
  "homepage": "https://github.com/sam-19/scoped-event-bus#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.11.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  }
}
